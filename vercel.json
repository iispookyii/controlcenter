{
  "version": 2,
  "routes": [
    { "src": "/api/auth(.*)", "dest": "/api/auth.js" },
    { "src": "/api/admins(.*)", "dest": "/api/admins.js" },
    { "src": "/api/data/(.*)", "dest": "/api/data.js" },
    { "src": "/(.*\\.(css|js|html|png|jpg|jpeg|svg|ico))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/dashboard.html" }
  ]
}
